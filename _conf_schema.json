{
    "ssb_auth": {
        "description": "搜书吧账密",
        "type": "string",
        "hint": "用于登录和搜索，格式：账号&密码",
        "default": ""
    },
    "sxsy_url": {
        "description": "尚香书苑网址",
        "type": "string",
        "hint": "用于尚香书苑搜索与监控，例如：https://sxsy18.com",
        "default": ""
    },
    "sxsy_cookie": {
        "description": "尚香书苑Cookie",
        "type": "string",
        "hint": "用于搜索，可以从浏览器获取",
        "default": ""
    },
    "search_result_count": {
        "description": "搜索结果数量",
        "hint": "设置每次搜索返回的结果数量",
        "type": "int",
        "slider": {
            "min": 5,
            "max": 20,
            "step": 1
        },
        "default": 10
    },
    "monitor_check_interval": {
        "description": "网站状态监控检测间隔(秒)",
        "hint": "仅在有订阅会话时执行检测",
        "type": "int",
        "slider": {
            "min": 10,
            "max": 86400,
            "step": 10
        },
        "default": 3600
    }
}
