{
    "ssb_auth": {
        "description": "搜书吧账密",
        "type": "string",
        "hint": "用于登录和搜索，格式：账号&密码",
        "default": ""
    },
    "sxsy_url": {
        "description": "SXSY 网址",
        "type": "string",
        "hint": "用于 SXSY 搜索与监控",
        "default": ""
    },
    "sxsy_cookie": {
        "description": "SXSY Cookie",
        "type": "string",
        "hint": "用于搜索，可以从浏览器获取",
        "default": ""
    },
    "search_result_count": {
        "description": "搜索结果数量",
        "hint": "设置每次搜索返回的结果数量",
        "type": "int",
        "slider": {
            "min": 5,
            "max": 20,
            "step": 1
        },
        "default": 10
    },
    "monitor_check_interval": {
        "description": "网站状态监控检测间隔(秒)",
        "hint": "仅在有订阅会话时执行检测",
        "type": "int",
        "slider": {
            "min": 10,
            "max": 86400,
            "step": 10
        },
        "default": 3600
    },
    "download_allow_users": {
        "description": "允许下载用户",
        "hint": "允许使用下载功能的用户 ID 列表。默认 0 表示仅管理员可用；留空表示所有人可用。",
        "type": "list",
        "default": [
            "0"
        ]
    },
    "daily_user_coin_limit": {
        "description": "单用户每日金币上限",
        "hint": "0 表示不限制",
        "type": "int",
        "default": 0
    },
    "daily_total_coin_limit": {
        "description": "全局每日金币上限",
        "hint": "0 表示不限制",
        "type": "int",
        "default": 0
    }
}
