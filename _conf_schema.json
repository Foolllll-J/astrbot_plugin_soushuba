{
    "auth": {
        "description": "站点登录凭证",
        "hint": "配置站点的账号密码和访问地址与 Cookie，用于登录鉴权和搜索下载。",
        "type": "object",
        "items": {
            "ssb": {
                "description": "搜书吧账号密码",
                "type": "string",
                "hint": "格式：账号&密码。用于登录搜书吧执行搜索和下载。",
                "default": ""
            },
            "sxsy": {
                "description": "尚香书苑登录配置",
                "type": "object",
                "items": {
                    "url": {
                        "description": "网站地址",
                        "type": "string",
                        "hint": "填写站点可用域名，用于搜索和状态监控。",
                        "default": ""
                    },
                    "cookie": {
                        "description": "Cookie",
                        "type": "string",
                        "hint": "从浏览器复制 Cookie 字段并填入，用于搜索鉴权。",
                        "default": ""
                    }
                }
            }
        }
    },
    "monitor": {
        "description": "站点状态监控",
        "hint": "配置站点的可用性检测频率和异常处理策略。",
        "type": "object",
        "items": {
            "check_interval": {
                "description": "检测间隔（秒）",
                "type": "int",
                "hint": "每隔多少秒检测一次站点可用性。不建议低于 60 秒，避免请求过于频繁。",
                "slider": {
                    "min": 60,
                    "max": 86400,
                    "step": 60
                },
                "default": 3600
            },
            "failure_recheck_delay": {
                "description": "异常复检延迟（秒）",
                "type": "int",
                "hint": "检测到站点异常后，延迟这么多秒再复核一次确认是否为真实异常。设为 0 表示不复核，直接判定为异常。",
                "slider": {
                    "min": 0,
                    "max": 3600,
                    "step": 60
                },
                "default": 300
            }
        }
    },
    "download": {
        "description": "下载功能控制",
        "hint": "管理允许下载的用户范围、每日金币消耗上限。留空或设为 0 表示不限制。",
        "type": "object",
        "items": {
            "allow_users": {
                "description": "允许下载的用户 ID",
                "type": "list",
                "hint": "填写用户 ID 列表。默认填写 \"0\" 表示仅管理员可用；留空则所有用户均可下载。",
                "default": [
                    "0"
                ]
            },
            "ban_download_users": {
                "description": "禁止下载用户列表",
                "type": "list",
                "hint": "填写用户 ID 列表。这些用户不允许购买/下载附件。留空则不限制。",
                "default": []
            },
            "daily_user_coin_limit": {
                "description": "单用户每日金币上限",
                "type": "int",
                "hint": "每个用户每天最多消耗多少金币用于下载。0 表示不限制。",
                "default": 0
            },
            "daily_total_coin_limit": {
                "description": "全局每日金币上限",
                "type": "int",
                "hint": "所有用户加起来每天最多消耗多少金币。0 表示不限制。",
                "default": 0
            },
            "prefer_free_download": {
                "description": "搜书吧免银币下载",
                "type": "bool",
                "hint": "开启后搜书吧付费附件优先走免银币直链，失败自动回退购买。关闭则始终走付费购买。",
                "default": false
            },
            "auto_zip_enabled": {
                "description": "发送失败自动打包 ZIP",
                "type": "bool",
                "hint": "开启后，普通文件发送失败时，自动将文件打包为 ZIP 重新发送，并提示解压密码（若有）。",
                "default": false
            },
            "auto_zip_password": {
                "description": "ZIP 加密密码",
                "type": "string",
                "hint": "补档 ZIP 使用的加密密码，留空表示不加密。开启自动打包 ZIP 后生效。",
                "default": ""
            }
        }
    },
    "search_result_count": {
        "description": "搜索结果数量",
        "type": "int",
        "hint": "每次搜索最多返回多少条结果。",
        "slider": {
            "min": 5,
            "max": 20,
            "step": 1
        },
        "default": 10
    },
    "proxy_url": {
        "description": "代理服务器地址",
        "type": "string",
        "hint": "留空表示直连。支持 HTTP/HTTPS/SOCKS5 代理，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080。配置后插件全部外部请求都将走此代理。",
        "default": ""
    }
}
